# Customer order records and backed-up identity documents.
# Nothing in here may ever be served over HTTP.

Require all denied

<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

# Second line of defence: even if a bad file were somehow written here,
# it must never be executed.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .cgi .pl
AddType text/plain .php .phtml .php3 .php4 .php5 .php7 .php8 .phps

Options -Indexes -ExecCGI
